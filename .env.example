# Copy to .env and fill in real values. .env must never be committed.

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me

DEBUG=False

# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://user:password@localhost:5432/tattoo

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1

# Required by settings.prod only:
# CORS_ALLOWED_ORIGINS=https://camcanhelp.com,https://www.camcanhelp.com
# CSRF_TRUSTED_ORIGINS=https://camcanhelp.com,https://www.camcanhelp.com
